{
  "name": "gamehub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --jsx=automatic --outfile=scripts/.smoke.cjs --log-level=warning && node scripts/.smoke.cjs",
    "smoke:ui": "esbuild scripts/ui-smoke.ts --bundle --platform=node --format=cjs --jsx=automatic --external:jsdom --outfile=scripts/.ui-smoke.cjs --log-level=warning && node scripts/.ui-smoke.cjs",
    "check": "npm run typecheck && npm run lint && npm run smoke && npm run smoke:ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.28.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.2.0"
  }
}
