{
  "name": "gamehub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --jsx=automatic --outfile=scripts/.smoke.cjs --log-level=warning && node scripts/.smoke.cjs",
    "smoke:ui": "esbuild scripts/ui-smoke.ts --bundle --platform=node --format=cjs --jsx=automatic --external:jsdom --outfile=scripts/.ui-smoke.cjs --log-level=warning && node scripts/.ui-smoke.cjs",
    "check": "npm run typecheck && npm run lint && npm run smoke && npm run smoke:ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "<6.1.0",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.2.0"
  }
}
